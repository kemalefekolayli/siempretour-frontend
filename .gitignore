# Tour data (JSON tours, country data, Python scripts).
# siempre_tour_country_datas(_tr) is an exception: template_tour_grid_page_2.js
# and _3.js fetch data/siempre_tour_country_datas(_tr)/{country}/datas.json at
# runtime for the "Genel Bakis" / "Gidilecek En iyi Zaman" tabs, and silently
# remove those tabs if the fetch 404s. It's small (~9MB, 721 files) so it ships
# as a normal Pages static asset like the rest of the site.
data/*
!data/siempre_tour_country_datas/
!data/siempre_tour_country_datas_tr/

# OS files
.DS_Store
Thumbs.db

# Wrangler CLI local cache/config
.wrangler/

# IDE / editor
.claude/
.vscode/
*.swp
*.swo
*~

# Source maps
*.css.map

# Node
node_modules/

# Environment
.env
.env.*
!.env.example
scripts/.azure-translation-cache.json
scripts/.tour-translation-cache.json
reports/tour-mojibake-report.json

# Large media files (serve via WordPress/CDN)
images/tour-photos/
images/gemi/
images/tour.mp4
images/austria-carosel/
avrupa-turlari.zip

# images/siempre-video1.mp4 is an exception: it's the homepage hero
# background video (index.html), actually referenced by the live site.
# It was never git-tracked, so every Pages deploy since the migration
# off the old non-git deploy method has been missing it - it only
# "worked" for some visitors because a handful of Cloudflare edges
# still had it cached from before. Committing it directly (5.8MB, well
# within Pages' per-file/file-count limits) makes it a normal asset
# like avrupa-turlari/siempretour-images, no CDN routing needed.

# Browser profile data (accidentally committed)
.edge-profile-shot/
.chrome-profile-shot/

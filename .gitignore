.wrangler/

# IDE / editor
.claude/
.vscode/
*.swp
*.swo
*~

# Source maps
*.css.map

# Node
node_modules/

# Environment
.env
.env.*
!.env.example
scripts/.azure-translation-cache.json
scripts/.tour-translation-cache.json
reports/tour-mojibake-report.json

# Large media files (serve via WordPress/CDN)
images/tour-photos/
images/gemi/
images/tour.mp4
images/siempre-video1.mp4
images/austria-carosel/

# Siempre Tour — Deployment Configuration Reference
# ---------------------------------------------------
# This is a STATIC site (no build step), so these values are NOT loaded from a
# .env file at runtime. They currently live as constants in JS. This file is a
# pre-deploy CHECKLIST: before deploying, confirm each value below is correct in
# the referenced file.

# Production backend API origin
# -> set in js/api-service.js  (const PROD_BACKEND_ORIGIN)
PROD_BACKEND_ORIGIN=https://siempretour-backend-629682499889.europe-west1.run.app

# Production chatbot API endpoint
# -> set in js/chat-widget.js  (var PROD_CHATBOT_API)
# NOTE: currently points at the main backend origin as a best guess. Update if the
# chatbot is a separate service.
PROD_CHATBOT_API=https://siempretour-backend-629682499889.europe-west1.run.app/api/chat

# CDN base URL for large media (European tour photos + hero video)
# -> to be wired into js/country-page-images.js, js/avrupa-photo-manifest.js,
#    and the homepage hero <video> once the bucket/CDN is provisioned.
CDN_BASE_URL=

# Public contact details (shown on contact page + KVKK page + footer)
# -> set in js/contact-config.js (CONTACT_CONFIG)
CONTACT_EMAIL=info@siempretour.com
CONTACT_PHONE=+90 546 587 00 48
CONTACT_ADDRESS=Cevatşakir Mah., Gümbet, Orkide Sk. No:15/1, 48400 Bodrum/Muğla

# Backend secrets (NOT used by the frontend — listed so they are never confused
# with frontend config). The production backend MUST use a JWT secret that is
# DIFFERENT from the local dev secret found in scripts/* (docker-local-dev-...).
# JWT_SECRET=<set on the backend only>
